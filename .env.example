# ---- Backend (FastAPI) ----
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=1.0
FETCH_CHUNK_DAYS=7
# Where the Elexon snapshot is cached (defaults to backend/data)
# DATA_DIR=/app/data
AUTO_FETCH_ON_EMPTY_CACHE=true
# UK-local delivery dates analysed (inclusive)
ANALYSIS_START=2026-01-01
ANALYSIS_END=2026-01-31
# Default decision cutoff: D-1 at this UK local time (assumption, configurable in the UI)
DEFAULT_CUTOFF_TIME=11:00
# Only needed when the frontend is served from a different origin than the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
LOG_LEVEL=INFO
# Built frontend to serve from FastAPI (set automatically in the root Dockerfile)
# STATIC_DIR=/app/static

# ---- Docker Compose ----
# Host port for the web UI (change if 8080 is already in use)
FRONTEND_PORT=8080

# ---- Frontend (Vite) ----
# Leave empty to call the API on the same origin (Vite dev proxy / nginx in Docker).
# Set to the backend URL when the frontend is hosted separately.
VITE_API_BASE_URL=
# Dev-server proxy target for /api
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
